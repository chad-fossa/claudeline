{
  "agentFiles": {
    "frontmatter": {
      "required": [
        "name",
        "description",
        "tools",
        "model",
        "memory"
      ],
      "rules": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "matchesFilenameStem": true
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Cap applies to the field VALUE (the string after 'description: '), NOT the raw line including the key prefix \u2014 measuring the line inflates by 13 chars and produces false positives."
        },
        "tools": {
          "type": "string",
          "minLength": 1,
          "description": "Comma-separated allowlist; no inheritance"
        },
        "model": {
          "type": "string",
          "enum": [
            "haiku",
            "sonnet",
            "opus",
            "inherit"
          ]
        },
        "memory": {
          "type": "string",
          "enum": [
            "project",
            "local",
            "user"
          ],
          "default": "project",
          "preferred": "project"
        }
      }
    },
    "body": {
      "requiredSections": [
        "Subagent name",
        "Purpose",
        "Main responsibility",
        "What it should investigate / do",
        "What it should NOT do",
        "Tool access",
        "Output format",
        "Behaviour rules"
      ],
      "requiredSectionHeading": {
        "level": 1,
        "pattern": "^# {section}$",
        "note": "Each required section must appear as a LEVEL-1 (#) heading matching ^# {section}$ EXACTLY \u2014 checked by literal regex per section (where {section} is substituted with the actual section name), never by interpretation. # Subagent name is the first; the rest follow. Deeper (## \u2026) sub-headings inside a section are fine; only the 8 required section headings are level-pinned. A required section heading at any other level (e.g. ## Purpose) is a structural FAILURE, reported identically every run \u2014 deterministic literal check, not interpreted."
      },
      "requiredRules": [
        "Re-read current code on every invocation; never trust memory for what code says",
        "Surface relevant memory as you work; when memory conflicts with current code or the user's intent, ask rather than assume \u2014 code is the default source of truth. Record resolved learnings with attribution (learned-from + date); mark superseded entries [?] rather than deleting them.",
        "If you made \u22653 tool calls, you MUST update MEMORY.md before returning. Empty MEMORY.md after \u22653 tool calls is a rule violation."
      ],
      "requiredRulesNote": "Rule 1 (re-read) is INTENT-checked, not verbatim: an agent whose primary input is not source code may adapt 'current code' to its actual input \u2014 e.g. 'Re-walk the docs surface on every invocation; don't trust memory for current state' (docs-researcher) or 'Re-read the artifact + findings on every invocation; never trust memory for what they say' (decider). Accept any phrasing carrying the re-read-current-reality + never-trust-memory intent. Rules 2 and 3 must appear VERBATIM (they are universal \u2014 every agent has memory)."
    },
    "limits": {
      "maxLines": 300
    }
  },
  "claudeMdFiles": {
    "nonRoot": {
      "mustReferenceAgent": true,
      "agentReferencePattern": "consult-expert: ([a-z][a-z0-9-]*)"
    }
  },
  "referenceLiveness": {
    "description": "Active references to agents, experts, skills, and file paths must resolve to something that exists. This catches the layer\u2192domain migration's recurring leak \u2014 a MOVED agent's old path or dispatch id, or a RETIRED expert's name, surviving in a sibling expert, a dispatching skill-expert, or a CLAUDE.md. Like deprecatedTerms, JUDGMENT-scoped: flag only ACTIVE references (a dispatch target, a 'Read agents/<\u2026>.md' instruction, a 'defer to <name>-expert' routing line, a CLAUDE.md/SKILL.md path link). Do NOT flag historical/explanatory mentions (CHANGELOG entries, 'X was retired/moved', ownership-map rows that document where something went). Route mechanical remediation to agent-maintainer (mode: modernize).",
    "checks": [
      {
        "id": "dispatch-id",
        "rule": "Active dispatch id `change-factory:<domain>:<agent>` resolves to an existing agents/<domain>/<agent>.md",
        "severity": "critical"
      },
      {
        "id": "agent-path",
        "rule": "Active path ref `agents/<domain>/<name>.md` or `skills/<skill>/<file>.md` resolves to an existing file",
        "severity": "important"
      },
      {
        "id": "directory-glob",
        "rule": "A directory-glob ref `agents/<domain>/*.md` resolves to an existing directory, AND any agent the same line names as living there (e.g. '`agents/<domain>/` (pr-drafter \u2014 Draft)') actually lives there. The literal-name sweep cannot catch a glob; resolve the glob and verify membership.",
        "severity": "important"
      },
      {
        "id": "expert-routing",
        "rule": "Routing prose \u2014 `defer <topic> to <name>-expert` / `<name>-expert owns <topic>` \u2014 must name an expert that BOTH (a) EXISTS as a file in the state dir's agents/ AND (b) still OWNS the routed topic. Ownership = the routed agent/topic lives in the domain that expert's description / domain CLAUDE.md claims to own. EXISTENCE ALONE IS INSUFFICIENT: the dominant migration drift is a routing line that didn't follow a moved agent \u2014 either its old expert was RETIRED when a layer dissolved (the reference now DANGLES at no file), OR the agent moved to a domain a DIFFERENT live expert now owns (the reference is STRANDED at a surviving expert that no longer owns the topic). Flag BOTH cases. (Real instance from this repo's history: a line 'defer agent-health to its old governance expert' after agent-health moved to agent-platform \u2014 once that governance expert was itself retired, the line became a dangling reference.) To check ownership, resolve where the routed agent actually lives (`agents/<domain>/<agent>.md`) and confirm that domain's CLAUDE.md `consult-expert:` is the expert the line names.",
        "severity": "important"
      }
    ]
  },
  "rosterCounts": {
    "description": "Explicit count claims in a domain CLAUDE.md or expert body ('N agents', 'N role-agents', 'N meta-agents', 'N mappers') must match the actual number of non-CLAUDE .md files in that domain directory. Hand-decremented counts drift every time an agent moves out \u2014 observed 3x in the layer\u2192domain migration (v0.25 / v0.27 / v0.29 Review roster read 4/5/6 across files). Resolve the count's CONVENTION from the same line (e.g. 'N role-agents (+ ux conditional)' counts core role-agents separately from the conditional resident) and check it against the directory's file count. Prefer name-listing over a bare count; a bare count with the wrong number is the failure. ADDITIVE CONVENTION: a multi-part label on one line (e.g. '3 read-only mappers + 2 domain-decomposition agents') carries MULTIPLE count-claims that SUM to the directory's non-CLAUDE file total (here 3+2=5); resolve and sum ALL claims on the line rather than checking only the first match in isolation.",
    "pattern": "([0-9]+) (agents|role-agents|meta-agents|mappers|read-only mappers|judge agents|domain-decomposition agents)",
    "severity": "important"
  },
  "memoryDirLiveness": {
    "description": "Every subdirectory of agent-memory/ must resolve to a LIVE owner \u2014 otherwise its accumulated memory is silently orphaned and rots. (The v0.25\u2013v0.35 layer\u2192domain migration relocated agents across domains but left ~17 memory dirs on their old prefix; nothing caught it because no rule checked memory-dir ownership.) Two dir-name shapes resolve differently: (a) a qualified change-factory agent dir `change-factory-<domain>-<agent>` must resolve to a live agent at dispatch id `change-factory:<domain>:<agent>` \u2014 an existing `agents/<domain>/<agent>.md`, resolved in-repo when this IS the plugin repo, else against the loaded/cached plugin's `agents/` (the same cache reach as the version-drift check); (b) a per-repo expert dir \u2014 shared-mode at `.claude/agent-memory/<expert-name>/` must resolve to `.claude/agents/<expert-name>.md`; local-mode at `.claude/agent-memory-local/<expert>/` must resolve to `.claude/agents/local/<expert>.md`. A dir resolving to neither is flagged \u2014 and the remediation is CLASSIFIED, never a bare delete (orphaned memory is renamed-not-dropped unless a human confirms it is dead): MOVED \u2014 the same agent/expert exists under a DIFFERENT current prefix (it changed domains, e.g. `change-factory-workflow-spec-writer` once spec-writer moved to `specification`) \u2192 recommend RENAME the dir to the current prefix, routed to `agent-maintainer` `mode: refactor` (which preserves + merges the memory); RETIRED \u2014 no live agent/expert exists under any prefix (the owner was dissolved) \u2192 recommend content-migrate-then-delete (fold any still-true entries into the successor's memory, then remove). This is the memory-dir analogue of `referenceLiveness`'s MOVED-vs-DANGLING split.",
    "checks": [
      {
        "id": "qualified-agent-dir",
        "rule": "`agent-memory/change-factory-<domain>-<agent>/` resolves to a live agent at dispatch id `change-factory:<domain>:<agent>` (`agents/<domain>/<agent>.md`). A dir whose `<agent>` matches a live agent under a DIFFERENT `<domain>` prefix is MOVED \u2192 recommend rename (route to agent-maintainer refactor); one matching no live agent anywhere is RETIRED \u2192 recommend content-migrate-then-delete. Never a bare delete.",
        "severity": "important"
      },
      {
        "id": "expert-dir",
        "rule": "Shared-mode: `.claude/agent-memory/<expert-name>/` resolves to an existing `.claude/agents/<expert-name>.md`. Local-mode: `.claude/agent-memory-local/<expert>/` resolves to an existing `.claude/agents/local/<expert>.md`. A live expert under a new name is MOVED (rename); a dissolved expert is RETIRED (content-migrate-then-delete).",
        "severity": "important"
      },
      {
        "id": "foreign-expert-dir",
        "rule": "A <expert-name> dir resolving to NO local .claude/agents/<expert-name>.md must ALSO be checked against workspaceRepos.paths siblings: if a sibling repo defines that expert, classify FOREIGN (a cross-repo dispatch wrote into this tree \u2014 CF-0015 incident class; remediation: relocate the dir's content to the owning repo's agent-memory and verify the consult-experts dispatch guard is in use), else RETIRED (existing rule).",
        "severity": "important"
      }
    ]
  },
  "skillFiles": {
    "description": "Lint skill files too, not only agents. Each skills/<skill>/SKILL.md must have frontmatter with a description; each skills/<skill>/CLAUDE.md must carry a consult-expert: ref that resolves (same liveness rule as agent CLAUDE.mds). Skill files are NOT held to the 8-section agent template (skills are free-form prose) \u2014 only frontmatter presence + consult-expert liveness + referenceLiveness apply to them.",
    "skillMdRequiresFrontmatter": [
      "description"
    ],
    "claudeMdConsultExpertResolves": true
  },
  "configDocTemplates": {
    "description": "Lint rule for files under resources/config-docs/. Every *.template.md in that directory must (a) contain all required section headings for its domain and (b) carry both cf:managed-start and cf:managed-end fence markers. This gives the net-new artifact class coverage at birth \u2014 a template missing a required heading or missing the managed fences is caught by agent-health before it ships to consuming repos.",
    "templateDir": "resources/config-docs",
    "checks": [
      {
        "id": "required-headings",
        "rule": "Each *.template.md under resources/config-docs/ must contain a set of required headings. For validator.template.md: Boot environment variables \u00b7 Never-run guardrails \u00b7 Canonical validate command \u00b7 Known-flaky areas \u00b7 Teardown gotchas \u00b7 What 'green' means for this repo. For ticketing.template.md: Adapter schema (containing Provider name \u00b7 State to intent mapping \u00b7 Container model \u00b7 Key format \u00b7 Trailer key). Any template added in the future must declare its required headings in this rule.",
        "severity": "important"
      },
      {
        "id": "managed-fences",
        "rule": "Each *.template.md under resources/config-docs/ must contain both the opening marker <!-- cf:managed-start --> and the closing marker <!-- cf:managed-end -->. A template missing either fence is a structural failure \u2014 Doctor reconcile depends on the fences to preserve repo-authored content.",
        "severity": "critical"
      }
    ]
  },
  "prShepherdBodyRef": {
    "description": "Cross-skill body-reference check (R14). When skills/pr-shepherd/body.md exists, both skills/pr-shepherd/SKILL.md and skills/address-pr-comments/SKILL.md must carry an active path-ref to it. This ensures the factored body artifact is reachable from both consumers and that neither skill silently diverges from the shared loop body.",
    "checks": [
      {
        "id": "shepherd-body-ref",
        "rule": "When skills/pr-shepherd/body.md exists: skills/pr-shepherd/SKILL.md must contain an active path reference to skills/pr-shepherd/body.md (e.g. a 'reads body' or 'see body.md' line). A missing ref means the skill no longer points at the factored body and may silently drift.",
        "severity": "important"
      },
      {
        "id": "address-pr-comments-body-ref",
        "rule": "When skills/pr-shepherd/body.md exists: skills/address-pr-comments/SKILL.md must contain an active path reference to skills/pr-shepherd/body.md. A missing ref means the standalone address-pr-comments skill runs without the shared body contract and may silently diverge.",
        "severity": "important"
      }
    ]
  },
  "directoryExcludeList": [
    "node_modules",
    "dist",
    "build",
    ".wrangler",
    ".next",
    ".turbo",
    "__snapshots__",
    "test-fixtures",
    "fixtures",
    "generated",
    "gen",
    "vendor",
    "coverage",
    ".git",
    ".claude"
  ],
  "conditionalReviewers": {
    "ux-reviewer": {
      "defaultEnabled": false,
      "enableInReposWith": "UX surface (React/Vue/HTML/CSS, mobile app code, design system docs)",
      "setVia": "Override in consuming repo's .claude/agent-lint.config by setting conditionalReviewers.ux-reviewer.enabled: true"
    }
  },
  "workspaceRepos": {
    "description": "Human-curated list of RELATED-CODEBASE paths whose change-factory experts `consult-experts` may interrogate cross-repo by dispatching their real experts natively after `/add-dir` + `/reload-plugins`. These are sibling repos that relate by architecture/concept (e.g. new-horizons \u2194 vcs-service, core \u2194 proto-schema) \u2014 NOT package dependencies, and never resolved from manifests or registries (a published package hosts no expert). POPULATED by the Init step 6c question + the Doctor 7a refresh (v0.34.0): the user names related codebases loosely (a keyword / description), and change-factory resolves each against the parent folder + the GitHub org (or a `look in <path>` override), confirms, and writes the local paths here. EXPLICIT by design \u2014 there is NO parent-dir auto-scan (it misses repos nested more than 1 level deep, e.g. core/FOSSA, and would sweep unrelated siblings' secrets). Empty = cross-repo consultation happens only when the user names a target repo at call time (the fallback). Resolve relative paths from the real repo root via `dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\"` (the common-dir points at the MAIN checkout's .git), NOT `git rev-parse --show-toplevel` (which returns the worktree root, a `.claude/worktrees/...` path, when run inside a worktree). Related-repo experts are registered in a session via the orientation /add-dir nudge + a `claude --add-dir <each-path>` launch pattern \u2014 NOT a settings auto-register (Claude Code has no settings key that registers subagents; `permissions.additionalDirectories` grants file access only).",
    "paths": [
      "/Users/chadfurman/dotfiles"
    ]
  },
  "diagrams": {
    "description": "Diagrammer (v0.23.0) config. `visualValidation` gates ONLY the rendered screen-fit/density critique on `mmdc` (mermaid-cli) being present \u2014 a plain present/absent conditional, NOT a safety tier. Init probes for `mmdc`; if absent it offers to install OR sets `visualValidation: false`, and the Doctor re-checks each run. Absent key = enabled (mmdc assumed present). With it false, diagram-reviewer still runs existence + edge-direction + hygiene checks (Mermaid renders on GitHub); only the local image critique is skipped. Diagrams live in `docs/diagrams/` and are referenced by a terse link from the relevant CLAUDE.md \u2014 never inline.",
    "visualValidation": true
  },
  "ticketing": {
    "description": "Work-item gate config (v0.32.0, provider-agnostic v0.53.0). The `ticketing` skill is ADVISORY and SILENT: it offers ticket/epic creation + Done-transitions but never blocks, and is a no-op unless BOTH `enabled: true` + a project key are set here AND the provider's MCP/tool is reachable. Absent key / absent block = disabled (no nagging a tracker-less repo). `provider: jira` (default when enabled) uses the Jira MCP directly. `provider: other` reads the repo's `ticketing/CLAUDE.md` config doc (mode-resolved) for state\u2192intent mapping, container model, key-format, and trailer-key. Init probes for a Jira MCP (step 8b) and offers to enable; the Doctor re-checks each run. Tickets map to PR-sized plan-decomposer GROUPS; `multi`-scope work becomes an epic + one child ticket per group. `trailer-key` configures the commit-trailer used to thread the work-item key (default: `Jira-Issue` for jira; set explicitly for other providers). Jira is the REFERENCE adapter; `provider: other` is contract-only / not exercised in this repo (no Jira key configured).",
    "enabled": true,
    "jira-project-key": null,
    "provider": "other",
    "trailer-key": "Ticket"
  },
  "delivery": {
    "description": "Delivery defaults read by orchestrate Step 2 (v0.52.0). `defaultEndState` sets the chain's default ship target when the user does not specify one: `pr` (default \u2014 open a non-draft PR off fresh mainline, auto-enter the shepherd watch) or `push` (merge to mainline + push, no PR). A repo that merges straight to mainline declares `push` here; absent the key, the default is `pr`. `useWorkflowReview` (v0.90.0 opt-in \u2192 v0.96.0 DEFAULT-ON, CF-0013): when `true` or ABSENT, orchestrate Step 9.1.b dispatches the reviewer floor through the `orchestrate-loop-body` workflow composer (which fans the `review-agents` leaf) \u2014 the CANONICAL path since the Phase-0 distribution spike proved cache-path resolution. Set `false` to keep the inline Agent fan-out; the inline path also remains the automatic narrated fallback when PLUGIN_BASE is unresolvable. The same floor runs either way. The config is the machine-read source; a CLAUDE.md note is human doc only.",
    "defaultEndState": "pr",
    "useWorkflowReview": true
  },
  "deprecatedTerms": {
    "description": "Vocabulary that signals an agent or memory file is drifting behind the current plugin. This is a JUDGMENT watch-list, not a blind regex: agent-health flags an occurrence only when it is an ACTIVE reference (a current-state claim, an invocation, or a dispatch target). It must NOT flag a historical or explanatory mention \u2014 e.g. 'signal-router was deleted', a CHANGELOG entry, or an ownership-map row that documents where the term went. agent-maintainer (mode: modernize) auto-applies the replacement for clearly-active references and flags the genuinely ambiguous ones for a human.",
    "terms": [
      {
        "term": "bootstrap-agents",
        "replacement": "the Init procedure in /change-factory:change-factory",
        "since": "0.17.0"
      },
      {
        "term": "expert-init",
        "replacement": "the Init procedure (post-reload self-bootstrap) in /change-factory:change-factory",
        "since": "0.17.0"
      },
      {
        "term": "change-factory:upgrade",
        "replacement": "/change-factory:change-factory upgrade (the Doctor procedure)",
        "since": "0.17.0",
        "note": "the standalone upgrade skill was folded into the entrypoint; the bare namespaced form is no longer a registered command"
      },
      {
        "term": "expert-router",
        "replacement": "main-thread routing via /change-factory:change-factory orientation",
        "since": "0.16.0"
      },
      {
        "term": "signal-router",
        "replacement": "main-thread routing via /change-factory:change-factory orientation",
        "since": "0.17.0"
      },
      {
        "term": "color-conflict-resolver",
        "replacement": "agent-maintainer (mode: color)",
        "since": "0.17.0"
      },
      {
        "term": "bootstrap-reviewer",
        "replacement": "agent-maintainer (mode: review)",
        "since": "0.17.0"
      },
      {
        "term": "expert-maintainer",
        "replacement": "agent-maintainer (mode: generate / survey)",
        "since": "0.17.0"
      },
      {
        "term": "refactor-expert",
        "replacement": "agent-maintainer (mode: refactor)",
        "since": "0.17.0"
      },
      {
        "term": "pattern-observer",
        "replacement": "on-demand cross-cutting sweep via /change-factory:change-factory doctor (deep mode)",
        "since": "0.17.0"
      },
      {
        "term": "observer",
        "replacement": "on-demand cross-cutting sweep via /change-factory:change-factory doctor (deep mode)",
        "since": "0.17.0",
        "note": "flag ONLY where it names the removed agent (a dispatch target or current-state claim), never the ordinary English word"
      },
      {
        "term": "dreamer",
        "replacement": "on-demand exploration via /change-factory:change-factory doctor (deep mode)",
        "since": "0.17.0",
        "note": "flag ONLY where it names the removed agent"
      }
    ]
  },
  "hookScriptParity": {
    "description": "change-factory-self only (the plugin repo dog-foods its own hook): .claude/hooks/cf-gate-*.py and resources/hooks/cf-gate-*.py must be byte-identical \u2014 the deposited copy must not silently drift from the shipped template. In consuming repos the Doctor step 6c owns the drift check instead (offer the re-copy).",
    "severity": "important"
  },
  "quick-init": {
    "description": "OPTIONAL marker written by the Init quick path (v0.63.0): true = this repo's experts are folder-grain from a single codebase-researcher pass. The Doctor's step-6 refresh surfaces a one-time upgrade nudge while present; a deep-pass re-decomposition removes it (absence = dismissed). Never set by hand; absent in thorough/shared-initialized repos."
  },
  "memoryGrounding": {
    "description": "Grounding-mandate compliance for expert memory facts (see resources/grounding-mandate.md \u2014 single source; never restate the ladder here). `confidenceLevels` is the executable mirror of the grounding-mandate ladder \u2014 keep in lockstep with that file; do not restate the prose ladder here. Checks CEREMONY only: source count + historical-type field present, not ref validity. Honest limit: a fabricated SHA passes the lint; fact accuracy is the expert self-check's job (doctor.md Step 7).",
    "confidenceLevels": {
      "very-low": {
        "minSources": 0,
        "minHistorical": 0
      },
      "low": {
        "minSources": 1,
        "minHistorical": 0
      },
      "medium": {
        "minSources": 3,
        "minHistorical": 1
      },
      "high": {
        "minSources": 3,
        "minHistorical": 1
      }
    },
    "sourceTypes": {
      "historical": [
        "commit",
        "pr",
        "doc"
      ],
      "non-historical": [
        "code-path",
        "test"
      ]
    },
    "checks": [
      {
        "id": "grounding-required",
        "rule": "A memory fact with confidence: low|medium|high MUST have a grounding: sources: list with at least the required number of entries for that tier.",
        "severity": "important"
      },
      {
        "id": "historical-required",
        "rule": "A memory fact with confidence: medium|high MUST have at least 1 source whose type is in sourceTypes.historical (commit|pr|doc). Agent-health derives this count by walking grounding.sources[] and matching each entry's type field against the sourceTypes.historical list \u2014 it never trusts a stored count. Count-only check: verifies the derived count meets minHistorical, not that the ref resolves.",
        "severity": "important"
      },
      {
        "id": "ungrounded-cap",
        "rule": "A fact with NO grounding: field MUST declare confidence: very-low or omit confidence entirely. A grounding-free fact with confidence: low|medium|high is a violation.",
        "severity": "important"
      }
    ],
    "scope": "Walk agent-memory/**/*.md and .claude/agent-memory/**/*.md. Apply per-fact, not per-file. JUDGMENT-scoped: flag only a STRUCTURED confidence: provenance key in a fact's metadata:/frontmatter block or a structured fact entry. Do NOT flag: confidence: inside fenced ``` code blocks (schema/illustrative examples); inline-prose mentions of confidence within a sentence; the enum-literal confidence: low|medium|high appearing as a schema definition. Do NOT flag prose narrative sections that contain no confidence: field.",
    "remediationRoute": "agent-maintainer (mode: modernize) auto-downgrades ungrounded medium|high to very-low. Adding real sources requires the owning expert."
  },
  "workflowModelPinning": {
    "enabled": true,
    "files": "workflows/*.workflow.js",
    "checker": "resources/hooks/check-model-pinning.py",
    "rule": "FIRST run `python3 resources/hooks/check-model-pinning.py --self-test` and assert exit 0 (the checker must prove it still catches all known bypass shapes before its verdict is trusted); THEN run `python3 resources/hooks/check-model-pinning.py` \u2014 the DETERMINISTIC authority for this rule (exit 0 = green; each FAIL: line is a finding). It verifies: every agentType dispatch resolves an explicit model; AGENT_MODEL/TERRAIN_MODEL mirror tables match agent frontmatter; inline model literals match the named agent's frontmatter; table completeness vs REVIEWER_AGENTS/NON_REVIEWER_AGENTS; modelFor fails loud (throw, no empty-object branch). Prose judgment is ONLY for constructs the script reports it cannot parse \u2014 never to overrule a FAIL. Background: the Workflow runtime does NOT read agent frontmatter; an omitted opts.model inherits the SESSION model.",
    "severity": "critical",
    "origin": "2026-07-03 \u2014 review floor + terrain agents + decomposer silently ran on the session model (Fable 5); the first prose-only version of this rule would have passed the very helper bug that caused it (gate finding)"
  }
}